<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>${groupId}</groupId>
    <artifactId>${rootArtifactId}-repository</artifactId>
    <version>${version}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>${artifactId}</artifactId>
  <packaging>war</packaging>

  <name>${artifactId}</name>

  <!-- in every profile the root of this war is the complete angular dist (community app
       + project customizations). repository/deploy/docker/frontend-server unpacks it into
       the frontend server image; repository/webapp copies assets/i18n and assets/images
       from the sources, not from this war -->

  <properties>
    <!-- the war is only consumed by the frontend server image of this reactor;
         nothing pulls it from the maven repository, so the upload is skipped -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <build>

    <finalName>edu-sharing</finalName>

  </build>

  <profiles>

    <profile>
      <id>frontend.default</id>

      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>

      <build>

        <plugins>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-war-plugin</artifactId>
            <configuration>
              <failOnMissingWebXml>false</failOnMissingWebXml>
            </configuration>
          </plugin>

        </plugins>

      </build>

    </profile>

    <profile>

      <id>frontend.overlay</id>

      <activation>
        <activeByDefault>false</activeByDefault>
        <file>
          <exists>src/main/ng</exists>
        </file>
      </activation>

      <properties>
        <!-- we need to use npm i since npm ci will not support nested package-lock files-->
        <npm.args.install>i</npm.args.install>
      </properties>

      <build>

        <plugins>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <configuration>
              <filesets>
                <fileset>
                  <directory>src/generated/ng</directory>
                </fileset>
              </filesets>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>unpack-dependencies</goal>
                </goals>
                <phase>generate-sources</phase>
                <configuration>
                  <includeArtifactIds>edu_sharing-community-repository-frontend</includeArtifactIds>
                  <classifier>sources</classifier>
                  <outputDirectory>src/generated/ng</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <phase>generate-sources</phase>
                <configuration>
                  <resources>
                    <resource>
                      <directory>src/main/ng</directory>
                    </resource>
                  </resources>
                  <outputDirectory>src/generated/ng</outputDirectory>
                  <overwrite>true</overwrite>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>com.github.eirslett</groupId>
            <artifactId>frontend-maven-plugin</artifactId>
            <configuration>
              <workingDirectory>src/generated/ng</workingDirectory>
              <!--suppress UnresolvedMavenProperty -->
              <nodeVersion>v${node.version}</nodeVersion>
              <!--suppress UnresolvedMavenProperty -->
              <npmVersion>${npm.version}</npmVersion>
            </configuration>
            <executions>
              <execution>
                <id>bootstrap</id>
                <goals>
                  <goal>install-node-and-npm</goal>
                </goals>
                <phase>process-sources</phase>
              </execution>
              <execution>
                <id>install</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>compile</phase>
                <configuration>
                  <arguments>${npm.args.install}</arguments>
                </configuration>
              </execution>
              <execution>
                <id>build</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>compile</phase>
                <configuration>
                  <arguments>${npm.args.build}</arguments>
                </configuration>
              </execution>
              <execution>
                <id>licenses</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>process-classes</phase>
                <configuration>
                  <arguments>run print-licenses</arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-war-plugin</artifactId>
            <configuration>
              <failOnMissingWebXml>false</failOnMissingWebXml>
              <webResources>
                <resource>
                  <directory>src/generated/ng/dist</directory>
                </resource>
              </webResources>
            </configuration>
          </plugin>

        </plugins>

      </build>

    </profile>



    <profile>

      <id>frontend.native</id>

      <activation>
        <activeByDefault>false</activeByDefault>
        <file>
          <exists>package.json</exists>
        </file>
      </activation>

      <build>

        <plugins>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <configuration>
              <filesets>
                <fileset>
                  <directory>src/app/edu-sharing</directory>
                </fileset>
                <fileset>
                  <directory>dist</directory>
                </fileset>
              </filesets>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>unpack-dependencies</goal>
                </goals>
                <phase>generate-sources</phase>
                <configuration>
                  <includeArtifactIds>edu_sharing-community-repository-frontend</includeArtifactIds>
                  <classifier>sources</classifier>
                  <outputDirectory>src/app/edu-sharing/Frontend</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>before</id>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <phase>generate-sources</phase>
                <configuration>
                  <resources>
                    <resource>
                      <directory>src/edu-sharing-override</directory>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                  <outputDirectory>src/app/edu-sharing/Frontend/src</outputDirectory>
                  <overwrite>true</overwrite>
                </configuration>
              </execution>
              <execution>
                <id>after</id>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <phase>process-classes</phase>
                <configuration>
                  <resources>
                    <resource>
                      <directory>src/app/edu-sharing/Frontend/src/assets/i18n</directory>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                  <outputDirectory>dist/assets/i18n</outputDirectory>
                  <overwrite>true</overwrite>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>com.github.eirslett</groupId>
            <artifactId>frontend-maven-plugin</artifactId>
            <configuration>
              <!--suppress UnresolvedMavenProperty -->
              <nodeVersion>v${node.version}</nodeVersion>
              <!--suppress UnresolvedMavenProperty -->
              <npmVersion>${npm.version}</npmVersion>
            </configuration>
            <executions>
              <execution>
                <id>bootstrap</id>
                <goals>
                  <goal>install-node-and-npm</goal>
                </goals>
                <phase>process-sources</phase>
              </execution>
              <execution>
                <id>install</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>process-sources</phase>
                <configuration>
                  <arguments>${npm.args.install}</arguments>
                </configuration>
              </execution>
              <execution>
                <id>build</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>compile</phase>
                <configuration>
                  <arguments>${npm.args.build}</arguments>
                </configuration>
              </execution>
              <execution>
                <id>licenses</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>process-classes</phase>
                <configuration>
                  <arguments>run print-licenses</arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-war-plugin</artifactId>
            <configuration>
              <failOnMissingWebXml>false</failOnMissingWebXml>
              <webResources>
                <resource>
                  <directory>dist</directory>
                </resource>
              </webResources>
            </configuration>
          </plugin>

        </plugins>

      </build>

    </profile>

    <profile>

      <id>frontend.storybook</id>

      <activation>
        <activeByDefault>false</activeByDefault>
        <file>
          <exists>storybook.build</exists>
        </file>
      </activation>

      <build>

        <plugins>

          <!-- Without project overrides (src/edu-sharing-override) the app and the web components
               would be rebuilt identical to the community build - they come from the community
               frontend war (war overlay) instead, only storybook is built. With overrides the app
               is built as before, so the customizations reach it. Decided here because a profile
               cannot require two files (storybook.build AND src/edu-sharing-override), and
               src/edu-sharing-override alone also belongs to frontend.native.
               The properties are deliberately not declared in the pom: declared ones would be
               interpolated before this script sets them. -->
          <plugin>
            <groupId>org.codehaus.gmavenplus</groupId>
            <artifactId>gmavenplus-plugin</artifactId>
            <executions>
              <execution>
                <id>storybook-app-build</id>
                <goals>
                  <goal>execute</goal>
                </goals>
                <phase>initialize</phase>
                <configuration>
                  <scripts>
                    <script><![CDATA[
                      // only calls on existing objects, no class literals: the groovy 3.0.9 of the
                      // super pom cannot read jdk 21 class files (as the other scripts of the sdk)
                      def overrides = project.basedir.toPath().resolve('src/edu-sharing-override').toFile().exists()
                      project.properties.setProperty('frontend.storybook.skipApp', (!overrides).toString())
                      project.properties.setProperty('frontend.storybook.skipLibs', overrides.toString())
                      log.info(overrides
                        ? 'frontend.storybook: src/edu-sharing-override present - building app, web components and storybook'
                        : 'frontend.storybook: no overrides - building storybook only, app and web components from the community frontend war')
                    ]]></script>
                  </scripts>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <configuration>
              <filesets>
                <fileset>
                  <directory>src/app/edu-sharing</directory>
                </fileset>
                <fileset>
                  <directory>dist</directory>
                </fileset>
              </filesets>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>unpack-dependencies</goal>
                </goals>
                <phase>generate-sources</phase>
                <configuration>
                  <includeArtifactIds>edu_sharing-community-repository-frontend</includeArtifactIds>
                  <classifier>sources</classifier>
                  <outputDirectory>src/app/edu-sharing/Frontend</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>before</id>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <phase>generate-sources</phase>
                <configuration>
                  <resources>
                    <resource>
                      <directory>src/edu-sharing-override</directory>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                  <outputDirectory>src/app/edu-sharing/Frontend/src</outputDirectory>
                  <overwrite>true</overwrite>
                </configuration>
              </execution>
              <execution>
                <id>after</id>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <phase>process-classes</phase>
                <configuration>
                  <!--suppress UnresolvedMavenProperty -->
                  <skip>${frontend.storybook.skipApp}</skip>
                  <resources>
                    <resource>
                      <directory>src/app/edu-sharing/Frontend/src/assets/i18n</directory>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                  <outputDirectory>dist/assets/i18n</outputDirectory>
                  <overwrite>true</overwrite>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>com.github.eirslett</groupId>
            <artifactId>frontend-maven-plugin</artifactId>
            <configuration>
              <!--suppress UnresolvedMavenProperty -->
              <nodeVersion>v${node.version}</nodeVersion>
              <!--suppress UnresolvedMavenProperty -->
              <npmVersion>${npm.version}</npmVersion>
              <workingDirectory>src/app/edu-sharing/Frontend</workingDirectory>
            </configuration>
            <executions>
              <execution>
                <id>bootstrap</id>
                <goals>
                  <goal>install-node-and-npm</goal>
                </goals>
                <phase>process-sources</phase>
              </execution>
              <execution>
                <id>install</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>process-sources</phase>
                <configuration>
                  <arguments>${npm.args.install}</arguments>
                </configuration>
              </execution>
              <execution>
                <id>build</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>compile</phase>
                <configuration>
                  <!--suppress UnresolvedMavenProperty -->
                  <skip>${frontend.storybook.skipApp}</skip>
                  <arguments>${npm.args.build}</arguments>
                </configuration>
              </execution>
              <!-- storybook alone still needs the libraries (edu-sharing-api, -ui, rendering-service-*),
                   which `npm run build` otherwise builds in its prebuild -->
              <execution>
                <id>storybook-libraries</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>compile</phase>
                <configuration>
                  <!--suppress UnresolvedMavenProperty -->
                  <skip>${frontend.storybook.skipLibs}</skip>
                  <arguments>run prebuild</arguments>
                </configuration>
              </execution>
              <execution>
                <id>frontend-build-storybook</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>compile</phase>
                <configuration>
                  <arguments>run build:storybook</arguments>
                </configuration>
              </execution>
              <execution>
                <id>licenses</id>
                <goals>
                  <goal>npm</goal>
                </goals>
                <phase>process-classes</phase>
                <configuration>
                  <!--suppress UnresolvedMavenProperty -->
                  <skip>${frontend.storybook.skipApp}</skip>
                  <arguments>run print-licenses</arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-war-plugin</artifactId>
            <configuration>
              <failOnMissingWebXml>false</failOnMissingWebXml>
              <webResources>
                <resource>
                  <directory>src/app/edu-sharing/Frontend/dist</directory>
                </resource>
              </webResources>
            </configuration>
          </plugin>

        </plugins>

      </build>

    </profile>


  </profiles>

  <dependencies>

    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>edu_sharing-community-repository-frontend</artifactId>
      <classifier>sources</classifier>
    </dependency>

    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>edu_sharing-community-repository-frontend</artifactId>
      <type>war</type>
    </dependency>

  </dependencies>

</project>
